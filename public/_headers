# Cloudflare Pages: response headers for the static export.
# Copied from public/ into out/ at build time, then read by Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Next.js fingerprinted bundles — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Static SVGs & screenshots — cache for a day; can be purged from Pages on deploy.
/branding/*
  Cache-Control: public, max-age=86400
/screenshots/*
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
