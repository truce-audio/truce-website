# Cloudflare Pages: response headers for the static export.
# Copied from public/ into out/ at build time, then read by Pages.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Next.js fingerprinted bundles — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets are publicly hot-linkable — CORS open so they can render in
# external README badges, social cards, slide decks, etc. without a proxy.
/branding/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/screenshots/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
/icon.svg
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
